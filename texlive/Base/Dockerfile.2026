# ---------------------------------------------
# Overleaf TexLive Base (ayaka-notes/overleaf)
# TeX Live 2026 (Ubuntu 24.04)
# ---------------------------------------------

# ---------------------------------------------
# How to pull? 
# $ docker pull ghcr.io/ayaka-notes/texlive-full:base-2026
# How to build?
# $ docker build -t ghcr.io/ayaka-notes/texlive-full:base-2026 -f ./texlive/Base/Dockerfile.2026 ./texlive/Base
# ---------------------------------------------

# This Dockerfile is used to build texlive-full:base-2026
# Only texlive:2026 is based on this
# Base Image Contain fonts, apt-installed component
FROM ubuntu:24.04

# LABEL
# -----------------------------------
LABEL \
    org.opencontainers.image.title="Docker Image of TeXLive" \
    org.opencontainers.image.authors="ayaka-notes <public@ayaka.space>" \
    org.opencontainers.image.source="https://github.com/ayaka-notes/texlive-full" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.description="Overleaf TeXLive Image by ayaka-notes"

# Makes sure LuaTex cache is writable
# -----------------------------------
ENV TEXMFVAR=/tmp/texmf-var
RUN mkdir -p /tmp/texmf-var && chmod -R 777 /tmp

# Set ENV to noninteractive
# -----------------------------------
ENV DEBIAN_FRONTEND noninteractive

# Update to ensure dependencies are updated
# ------------------------------------------
ENV REBUILT_AFTER="2026-01-13"


# Set up tex user and home directory (match upstream)
# ---------------------------------------------------
RUN set -eux; \
    user="$(getent passwd 1000 | cut -d: -f1 || true)"; \
    if [ -n "$user" ]; then userdel -r "$user"; fi; \
    group="$(getent group 1000 | cut -d: -f1 || true)"; \
    if [ -n "$group" ]; then groupdel "$group"; fi; \
    groupadd -g 1000 tex; \
    useradd -m -u 1000 -g 1000 -d /home/tex -s /bin/sh \
    -c "You are in a sandboxed container without access to outside resources ^_^" \
    tex; \
    passwd -d tex; \
    chmod 750 /home/tex


# Add CRAN's Ubuntu repository
# Ubuntu 24.04 自带的 R 是 4.3.x，官方镜像用的是 CRAN 构建的 4.6.0
# --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gnupg dirmngr wget \
    && wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc \
       | gpg --dearmor -o /usr/share/keyrings/cran.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cran.gpg] https://cloud.r-project.org/bin/linux/ubuntu noble-cran40/" \
       > /etc/apt/sources.list.d/cran.list \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
# --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt base-files base-passwd bash bsdutils chktex coinor-libcgl-dev coinor-libcgl1 coinor-libclp-dev coinor-libclp1 coinor-libcoinutils-dev coinor-libcoinutils3v5 coinor-libosi-dev coinor-libosi1v5 coinor-libsymphony-dev coinor-libsymphony3 coreutils culmus dash debconf debianutils default-jdk-headless diffutils dirmngr dot2tex dpkg e2fsprogs findutils gcc-14-base ghostscript gnuplot gpgv graphviz grep gsfonts gzip hostname imagemagick init-system-helpers inkscape libacl1 libamd3 libapt-pkg6.0t64 libassuan0 libattr1 libaudit-common libaudit1 libblkid1 libbz2-1.0 libc-bin libc6 libcap-ng0 libcap2 libcolamd3 libcom-err2 libcrypt1 libcurl4t64 libdebconfclient0 libexpat1 libext2fs2t64 libffi8 libfftw3-bin libfont-ttf-perl libfontconfig1 libfreetype6 libgcc-s1 libgcrypt20 libgdal34t64 libglpk40 libglut3.12 libgmp10 libgnutls30t64 libgpg-error0 libgsl27 libhogweed6t64 libidn12 libidn2-0 libijs-0.35 libio-string-perl libjbig2dec0 libjpeg8 liblcms2-2 liblz4-1 liblzma5 libmagick++-6.q16-9t64 libmagick++-6.q16hdri-9t64 libmd0 libmount1 libncurses6 libncursesw6 libnettle8t64 libnpth0t64 libopenjp2-7 libosmesa6 libp11-kit0 libpam-modules libpam-modules-bin libpam-runtime libpam0g libpaper1 libpcre2-8-0 libpdf-api2-perl libpdf-api2-xs-perl libpng16-16t64 libproc2-0 libseccomp2 libselinux1 libsemanage-common libsemanage2 libsepol2 libsmartcols1 libss2 libssl3t64 libstdc++6 libsuitesparseconfig7 libsystemd0 libtasn1-6 libtiff6 libtinfo6 libudev1 libudunits2-0 libunistring5 libuuid1 libxml2 libxxhash0 libzstd1 login logsave mawk mount ncurses-base ncurses-bin passwd perl perl-base procps python-is-python3 python3-numpy python3-pdfrw python3-pygments python3-scipy python3-simpy qpdf sed sensible-utils software-properties-common strace sysvinit-utils t1-cyrillic tar time ttf-bitstream-vera ubuntu-keyring unminimize util-linux wget zlib1g\
    make cmake build-essential gfortran\
    gnupg ca-certificates dirmngr \
    libblas-dev liblapack-dev libcurl4-openssl-dev libssl-dev libxml2-dev zlib1g-dev libfontconfig1-dev libmagick++-dev libudunits2-dev libgdal-dev\
    libfftw3-dev libgmp-dev libgsl0-dev libharfbuzz-dev libfribidi-dev libmpfr-dev libuv1-dev jags\
    && rm -rf /var/lib/apt/lists/*

# Install R at the exact upstream version, then hold it
# --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base-core=4.6.0-4.2404.0 \
    r-base=4.6.0-4.2404.0 \
    r-cran-boot=1.3-32-1.2404.0 \
    r-cran-class=7.3-23-1.2404.0 \
    r-cran-cluster=2.1.8.2-1.2404.0 \
    r-cran-codetools=0.2-20-1.2404.0 \
    r-cran-foreign=0.8.91-1.2404.0 \
    r-cran-kernsmooth=2.23-26-1.2404.0 \
    r-cran-lattice=0.22-9-1.2404.0 \
    r-cran-mass=7.3-65-1.2404.0 \
    r-cran-matrix=1.7-5-1.2404.0 \
    r-cran-mgcv=1.9-4-1.2404.0 \
    r-cran-nlme=3.1.169-1.2404.0 \
    r-cran-nnet=7.3-20-1.2404.0 \
    r-cran-rpart=4.1.27-1.2404.0 \
    r-cran-spatial=7.3-17-1.2404.0 \
    r-cran-survival=3.8-6-1.2404.0 \
    r-recommended=4.6.0-4.2404.0 \
    && apt-mark hold r-base-core r-base r-cran-boot r-cran-class r-cran-cluster r-cran-codetools r-cran-foreign r-cran-kernsmooth r-cran-lattice r-cran-mass r-cran-matrix r-cran-mgcv r-cran-nlme r-cran-nnet r-cran-rpart r-cran-spatial r-cran-survival r-recommended \
    && rm -rf /var/lib/apt/lists/*

# Install Extra fonts
# --------------------
COPY ./extrafonts /usr/share/fonts/

# Install fonts
# --------------------
RUN echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections \
    && apt-get update && apt-get install -y ttf-mscorefonts-installer \
    && apt update && apt search ^fonts  | grep -o '^fonts[^/]*' | grep -vE '^(fonts-ubuntu-classic)$' | xargs apt-get install -y \
    && wget --quiet https://github.com/google/fonts/archive/main.tar.gz -O gf.tar.gz \
    && rm -rf /var/lib/apt/lists/* \
    && tar -xf gf.tar.gz \
    && mkdir -p /usr/share/fonts/truetype/google-fonts \
    && find $PWD/fonts-main/ -name "*.ttf" -exec install -m644 {} /usr/share/fonts/truetype/google-fonts/ \; || return 1 \
    && rm -rf gf.tar.gz fonts-main \
    && fc-cache -f && rm -rf /var/cache/*

# Install R packages (one shot, non-interactive, pinned repo)
# --------------------
COPY ./install-r-package-2026.R /tmp/install_r_packages.R
RUN Rscript /tmp/install_r_packages.R && rm -f /tmp/install_r_packages.R

# LANG=C.UTF−8 for R knitr
# --------------------
ENV LANG=C.UTF-8
